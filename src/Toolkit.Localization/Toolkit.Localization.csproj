<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<MinVerMinimumMajorMinor>6.0</MinVerMinimumMajorMinor>
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
		<TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<PackageId>VolocyNazad.$(AssemblyName)</PackageId>
		<Authors>VolocyNazad</Authors>
		<Company>VolocyNazad</Company>
		<LangVersion>14</LangVersion>
		<ImplicitUsings>true</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>Extensions and implementations for 'Microsort.Extensions.Localization' and 'Microsort.Extensions.Localization.Abstractions'</Description>
		<RepositoryUrl>https://github.com/VolocyNazad/Toolkit.Localization</RepositoryUrl>
		<PackageTags>Localization</PackageTags>
		<!--<GeneratePackageOnBuild>true</GeneratePackageOnBuild>-->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Localization" />
		<PackageReference Include="AutoConstructor">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PolySharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>
